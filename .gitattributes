# Files that run inside Linux containers must keep LF line endings, even on
# a Windows checkout with core.autocrlf=true. A CRLF in a shell script or
# entrypoint breaks it ("/bin/sh^M: not found"), and Docker builds from the
# working tree, not from what's in git.
*.sh            text eol=lf
Dockerfile      text eol=lf
*.Dockerfile    text eol=lf
.dockerignore   text eol=lf
*.conf          text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.mjs           text eol=lf
.env.example    text eol=lf
