# Settings for `docker compose` (copy this file to .env in the repo root).
# The root .env is gitignored. Never commit real values.
#
# This is separate from api/.env, which is only used by `npm run dev`.

# REQUIRED. Long random string used to sign login tokens (32+ characters).
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# How long a login token lasts.
JWT_EXPIRES_IN=1h

# Admin account created by `docker compose run --rm seed`.
# Admins can't sign up through the app. Password must be 12+ characters.
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Administrator
ADMIN_PASSWORD=

# Optional: use MongoDB Atlas instead of the mongo container. Leave it
# commented out to use the local replica set (mongodb://mongo:27017/...).
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/hustlehub
