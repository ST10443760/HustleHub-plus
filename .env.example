# Settings for `docker compose` (copy this file to .env in the repo root).
# The root .env is gitignored. Never commit real values.
#
# This is separate from api/.env, which is only used by `npm run dev`.

# REQUIRED. Long random string used to sign login tokens (32+ characters).
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# How long a login token lasts.
JWT_EXPIRES_IN=1h

# Admin account created by `docker compose run --rm seed`.
# Admins can't sign up through the app. Password must be 12+ characters.
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Administrator
ADMIN_PASSWORD=

# Optional: use MongoDB Atlas instead of the mongo container. Leave it
# commented out to use the local replica set (mongodb://mongo:27017/...).
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/hustlehub

# Logging for the api container. json (one JSON record per line) is the
# default here; set LOG_FORMAT=pretty for readable lines.
LOG_FORMAT=json

# Optional cloud logging (Axiom). Leave EMPTY to keep logs in
# `docker compose logs api` only. Both must be set to ship:
#   LOG_SHIPPING_URL    https://<edge-domain>/v1/ingest/<dataset>
#   LOG_SHIPPING_TOKEN  an Axiom API token that can ONLY ingest into that
#                       one dataset. Never commit it.
# They reach the api container as runtime environment variables only
# (never a build arg, so never in an image layer). The test override
# (docker-compose.test.yml) never ships.
LOG_SHIPPING_URL=
LOG_SHIPPING_TOKEN=
