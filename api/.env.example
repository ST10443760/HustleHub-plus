PORT=5000
NODE_ENV=development

# MongoDB connection string (local or Atlas). Put the real one in .env only.
MONGO_URI=mongodb://localhost:27017/hustlehub

# Virona: JWT secret goes here - generate a long random string, never commit the real value.
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1h

# Admin account created by `npm run seed:admin` (admins can't self-register).
# Placeholders only - put the real values in .env. Password must be 12+ characters.
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=HustleHub Admin
ADMIN_PASSWORD=replace_with_a_strong_password

# The only browser origin allowed to call the API (CORS) and in the CSP connect-src.
CLIENT_ORIGIN=http://localhost:5173

# Optional, for local testing only: raise the max of a rate limiter.
# Ignored when NODE_ENV=production, where the strict defaults always apply.
# RATE_LIMIT_LOGIN_MAX=5
# RATE_LIMIT_REGISTER_MAX=10
# RATE_LIMIT_BOOKING_MAX=10
# RATE_LIMIT_PASSWORD_CHANGE_MAX=5
# RATE_LIMIT_GENERAL_MAX=100

# Optional, for local testing only: change the account lockout policy
# (default: 5 failed attempts within 15 minutes lock the account for 15
# minutes). Ignored when NODE_ENV=production.
# LOCKOUT_MAX_ATTEMPTS=5
# LOCKOUT_WINDOW_MINUTES=15
# LOCKOUT_DURATION_MINUTES=15

# Logging. LOG_FORMAT is "pretty" (readable lines, the default here) or
# "json" (one JSON record per line, the default when NODE_ENV=production).
LOG_FORMAT=

# Optional cloud logging (Axiom). Leave EMPTY to keep logs on the console
# only. Both must be set to ship:
#   LOG_SHIPPING_URL    https://<edge-domain>/v1/ingest/<dataset>
#   LOG_SHIPPING_TOKEN  an Axiom API token that can ONLY ingest into that
#                       one dataset. Never commit it.
# Never shipped from tests or `npm run start:test` unless
# LOG_SHIPPING_IN_TEST=1 is set as well (for a demo).
# Check the connection with: npm run log:test
LOG_SHIPPING_URL=
LOG_SHIPPING_TOKEN=
# LOG_SHIPPING_IN_TEST=1
