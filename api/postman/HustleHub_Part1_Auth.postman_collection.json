{
  "info": {
    "name": "HustleHub+ Part 1 - Auth API",
    "description": "Registration, login, and JWT-protected route testing for HustleHub+ Part 1 (Secure Foundations). Covers valid and invalid scenarios per the rubric requirement.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "https://localhost:5000" },
    { "key": "token", "value": "" },
    { "key": "test_email", "value": "" },
    { "key": "client_token", "value": "" },
    { "key": "freelancer_token", "value": "" },
    { "key": "admin_token", "value": "" },
    { "key": "rbac_client_email", "value": "" },
    { "key": "rbac_freelancer_email", "value": "" },
    { "key": "rbac_admin_attempt_email", "value": "" },
    { "key": "admin_email", "value": "" },
    { "key": "admin_password", "value": "" }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/health"
      }
    },
    {
      "name": "Register - Success",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// Data persists in MongoDB now, so every run needs its own email.",
              "// Generated once here and reused by the requests that follow.",
              "const unique = Date.now() + '-' + Math.floor(Math.random() * 10000);",
              "pm.collectionVariables.set('test_email', 'test-' + unique + '@example.com');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 201', () => pm.response.to.have.status(201));",
              "pm.test('Returns a token', () => {",
              "  const json = pm.response.json();",
              "  pm.expect(json.data.token).to.be.a('string');",
              "  pm.collectionVariables.set('token', json.data.token);",
              "});",
              "pm.test('No password hash leaked', () => {",
              "  const json = pm.response.json();",
              "  pm.expect(json.data.user.passwordHash).to.be.undefined;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"{{test_email}}\",\n  \"password\": \"password123\"\n}"
        },
        "url": "{{base_url}}/api/auth/register"
      }
    },
    {
      "name": "Register - Duplicate Email (should fail)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 409', () => pm.response.to.have.status(409));",
              "pm.test('No stack trace in response', () => {",
              "  pm.expect(pm.response.text()).to.not.include('at ');",
              "  pm.expect(pm.response.text()).to.not.include('.js:');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"{{test_email}}\",\n  \"password\": \"password123\"\n}"
        },
        "url": "{{base_url}}/api/auth/register"
      }
    },
    {
      "name": "Register - Invalid Input (should fail)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 400', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"T\",\n  \"email\": \"not-an-email\",\n  \"password\": \"123\"\n}"
        },
        "url": "{{base_url}}/api/auth/register"
      }
    },
    {
      "name": "Login - Success",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.test('Returns a token', () => {",
              "  const json = pm.response.json();",
              "  pm.expect(json.data.token).to.be.a('string');",
              "  pm.collectionVariables.set('token', json.data.token);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{test_email}}\",\n  \"password\": \"password123\"\n}"
        },
        "url": "{{base_url}}/api/auth/login"
      }
    },
    {
      "name": "Login - Wrong Password (should fail)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 401', () => pm.response.to.have.status(401));",
              "pm.test('Generic error message (no user enumeration)', () => {",
              "  const json = pm.response.json();",
              "  pm.expect(json.error).to.eql('Invalid email or password');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{test_email}}\",\n  \"password\": \"wrongpassword\"\n}"
        },
        "url": "{{base_url}}/api/auth/login"
      }
    },
    {
      "name": "Login - Unknown Email (should fail)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 401', () => pm.response.to.have.status(401));",
              "pm.test('Same generic message as wrong password', () => {",
              "  const json = pm.response.json();",
              "  pm.expect(json.error).to.eql('Invalid email or password');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"doesnotexist@example.com\",\n  \"password\": \"password123\"\n}"
        },
        "url": "{{base_url}}/api/auth/login"
      }
    },
    {
      "name": "Protected Route - No Token (should fail)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/auth/me"
      }
    },
    {
      "name": "Protected Route - Invalid Token (should fail)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer garbage.token.value" }],
        "url": "{{base_url}}/api/auth/me"
      }
    },
    {
      "name": "Protected Route - Valid Token (should succeed)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.test('Returns the authenticated user', () => {",
              "  const json = pm.response.json();",
              "  pm.expect(json.data.user.email).to.eql(pm.collectionVariables.get('test_email'));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{base_url}}/api/auth/me"
      }
    },
    {
      "name": "RBAC",
      "description": "Role-based access control: admin routes need a token AND the admin role, and admin can never be chosen at public registration.",
      "item": [
        {
          "name": "Register Client (setup)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const unique = Date.now() + '-' + Math.floor(Math.random() * 10000);",
                  "pm.collectionVariables.set('rbac_client_email', 'test-' + unique + '@example.com');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.test('Role is client', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.data.user.role).to.eql('client');",
                  "  pm.collectionVariables.set('client_token', json.data.token);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"RBAC client\",\n  \"email\": \"{{rbac_client_email}}\",\n  \"password\": \"password123\",\n  \"role\": \"client\"\n}"
            },
            "url": "{{base_url}}/api/auth/register"
          }
        },
        {
          "name": "Register Freelancer (setup)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const unique = Date.now() + '-' + Math.floor(Math.random() * 10000);",
                  "pm.collectionVariables.set('rbac_freelancer_email', 'test-' + unique + '@example.com');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.test('Role is freelancer', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.data.user.role).to.eql('freelancer');",
                  "  pm.collectionVariables.set('freelancer_token', json.data.token);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"RBAC freelancer\",\n  \"email\": \"{{rbac_freelancer_email}}\",\n  \"password\": \"password123\",\n  \"role\": \"freelancer\"\n}"
            },
            "url": "{{base_url}}/api/auth/register"
          }
        },
        {
          "name": "Admin Users - No Token (should fail)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/admin/users"
          }
        },
        {
          "name": "Admin Users - Client Token (should fail)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 403', () => pm.response.to.have.status(403));",
                  "pm.test('Generic message, required role not revealed', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.error).to.eql('You do not have permission to perform this action');",
                  "  pm.expect(pm.response.text()).to.not.include('admin');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{client_token}}"
              }
            ],
            "url": "{{base_url}}/api/admin/users"
          }
        },
        {
          "name": "Admin Users - Freelancer Token (should fail)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 403', () => pm.response.to.have.status(403));",
                  "pm.test('Generic message, required role not revealed', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.error).to.eql('You do not have permission to perform this action');",
                  "  pm.expect(pm.response.text()).to.not.include('admin');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{freelancer_token}}"
              }
            ],
            "url": "{{base_url}}/api/admin/users"
          }
        },
        {
          "name": "Register - Admin Role (should fail)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const unique = Date.now() + '-' + Math.floor(Math.random() * 10000);",
                  "pm.collectionVariables.set('rbac_admin_attempt_email', 'test-' + unique + '@example.com');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('No token issued', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.success).to.eql(false);",
                  "  pm.expect(json.data).to.be.undefined;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sneaky Admin\",\n  \"email\": \"{{rbac_admin_attempt_email}}\",\n  \"password\": \"password123\",\n  \"role\": \"admin\"\n}"
            },
            "url": "{{base_url}}/api/auth/register"
          }
        },
        {
          "name": "Admin Login (skipped without admin credentials)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Only runs when admin credentials are supplied, e.g.",
                  "// newman run ... --env-var admin_email=... --env-var admin_password=...",
                  "if (!pm.variables.get('admin_email') || !pm.variables.get('admin_password')) {",
                  "  console.log('Skipping: admin_email / admin_password not set');",
                  "  pm.execution.skipRequest();",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Logged in as admin', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.data.user.role).to.eql('admin');",
                  "  pm.collectionVariables.set('admin_token', json.data.token);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}"
            },
            "url": "{{base_url}}/api/auth/login"
          }
        },
        {
          "name": "Admin Users - Admin Token (skipped without admin credentials)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Only runs when admin credentials are supplied, e.g.",
                  "// newman run ... --env-var admin_email=... --env-var admin_password=...",
                  "if (!pm.variables.get('admin_email') || !pm.variables.get('admin_password')) {",
                  "  console.log('Skipping: admin_email / admin_password not set');",
                  "  pm.execution.skipRequest();",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Returns users with no password hashes', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.data.users).to.be.an('array').that.is.not.empty;",
                  "  json.data.users.forEach((u) => pm.expect(u.passwordHash).to.be.undefined);",
                  "});",
                  "pm.test('Newest first', () => {",
                  "  const users = pm.response.json().data.users;",
                  "  for (let i = 1; i < users.length; i++) {",
                  "    pm.expect(new Date(users[i - 1].createdAt) >= new Date(users[i].createdAt)).to.be.true;",
                  "  }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": "{{base_url}}/api/admin/users"
          }
        }
      ]
    }
  ]
}
