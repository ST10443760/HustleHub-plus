    {
      "name": "RBAC",
      "description": "Role-based access control: admin routes need a token AND the admin role, and admin can never be chosen at public registration.",
      "item": [
        {
          "name": "Register Client (setup)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const unique = Date.now() + '-' + Math.floor(Math.random() * 10000);",
                  "pm.collectionVariables.set('rbac_client_email', 'test-' + unique + '@example.com');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.test('Role is client', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.data.user.role).to.eql('client');",
                  "  pm.collectionVariables.set('client_token', json.data.token);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"RBAC client\",\n  \"email\": \"{{rbac_client_email}}\",\n  \"password\": \"password123\",\n  \"role\": \"client\"\n}"
            },
            "url": "{{base_url}}/api/auth/register"
          }
        },
        {
          "name": "Register Freelancer (setup)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const unique = Date.now() + '-' + Math.floor(Math.random() * 10000);",
                  "pm.collectionVariables.set('rbac_freelancer_email', 'test-' + unique + '@example.com');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.test('Role is freelancer', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.data.user.role).to.eql('freelancer');",
                  "  pm.collectionVariables.set('freelancer_token', json.data.token);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"RBAC freelancer\",\n  \"email\": \"{{rbac_freelancer_email}}\",\n  \"password\": \"password123\",\n  \"role\": \"freelancer\"\n}"
            },
            "url": "{{base_url}}/api/auth/register"
          }
        },
        {
          "name": "Admin Users - No Token (should fail)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 401', () => pm.response.to.have.status(401));"
