              "listen": "prerequest",
              "script": {
                "exec": [
                  "const unique = Date.now() + '-' + Math.floor(Math.random() * 10000);",
                  "pm.collectionVariables.set('rl_unknown_email', 'test-' + unique + '@example.com');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
