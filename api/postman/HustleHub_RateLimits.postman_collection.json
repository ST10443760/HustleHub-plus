        {
          "name": "Failed Login 6 (rate limited)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 429', () => pm.response.to.have.status(429));",
                  "pm.test('Retry-After header with a sensible number of seconds', () => {",
                  "  const retryAfter = Number(pm.response.headers.get('Retry-After'));",
                  "  pm.expect(Number.isInteger(retryAfter)).to.eql(true);",
                  "  pm.expect(retryAfter).to.be.within(1, 900);",
                  "});",
                  "pm.test('Meaningful message that matches Retry-After', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.success).to.eql(false);",
                  "  const match = /^Too many requests, please try again in (\\d+) seconds\\.$/.exec(body.error);",
                  "  pm.expect(match, body.error).to.not.eql(null);",
                  "  pm.expect(Number(match[1])).to.eql(Number(pm.response.headers.get('Retry-After')));",
                  "});",
                  "pm.test('Standard RateLimit headers, no legacy X-RateLimit headers', () => {",
                  "  pm.expect(pm.response.headers.has('RateLimit')).to.eql(true);",
                  "  pm.expect(pm.response.headers.has('X-RateLimit-Limit')).to.eql(false);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
